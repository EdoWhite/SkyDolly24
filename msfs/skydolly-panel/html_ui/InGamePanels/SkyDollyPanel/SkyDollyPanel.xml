<?xml version="1.0" encoding="utf-8"?>
<!-- Registers the Sky Dolly panel with the simulator's toolbar.

     Custom in-game panels are a community technique rather than a documented SDK feature: the
     simulator scans html_ui/InGamePanels for panel descriptors and adds an entry to the toolbar for
     each one it recognises. A Sim Update can change this, which is why the same interface is also
     reachable at http://127.0.0.1:17285/ from any browser on this PC.

     Ident must be unique across all installed packages. -->
<PanelConfiguration>
  <Ident>SKYDOLLY_PANEL</Ident>
  <Name>Sky Dolly</Name>
  <Icon>ICON_TOOLBAR_SKYDOLLY</Icon>
  <Url>/InGamePanels/SkyDollyPanel/SkyDollyPanel.html</Url>
  <DefaultSize Width="320" Height="560"/>
  <MinSize Width="280" Height="380"/>
  <Resizable>True</Resizable>
</PanelConfiguration>
